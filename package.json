{
  "name": "archer-cms",
  "version": "2.0.0",
  "private": true,
  "description": "A full-stack CMS built with React, Express, SQLite, and Passport auth.",
  "type": "module",
  "author": "Jennifer Tesolin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jennifert/archer-cms.git"
  },
  "bugs": {
    "url": "https://github.com/jennifert/archer-cms/issues"
  },
  "homepage": "https://github.com/jennifert/archer-cms#readme",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "dependencies": {
    "@picocss/pico": "^2.1.1",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.5.0",
    "express": "^5.2.1",
    "express-session": "^1.18.1",
    "multer": "^2.0.1",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2",
    "sequelize": "^6.37.7",
    "sqlite3": "^6.0.1"
  },
  "scripts": {
    "dev": "concurrently \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "nodemon app.js",
    "build": "vite build",
    "postbuild": "node scripts/swap-robots.js",
    "serve": "vite preview",
    "start": "node app.js",
    "seed": "node import.js --force",
    "seed:safe": "node import.js",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.11.0",
    "nodemon": "^3.1.10",
    "vite": "^6.3.5"
  }
}